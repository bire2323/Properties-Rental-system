
// if you have not set up a secret key yet, you can generate one using the following command in your terminal:
//
// python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=your_secret_key_here

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Chapa payment gateway
# CHAPA_API_BASE=https://api.chapa.co/v1
# CHAPA_SECRET_KEY=CHASECK_TEST-...
# CHAPA_PUBLIC_KEY=CHAPUBK_TEST-...
# CHAPA_WEBHOOK_SECRET=...
# CHAPA_CURRENCY=ETB
# Callback/webhook must be publicly reachable by Chapa. In local dev use your
# active ngrok HTTPS URL. NOTE: these paths must match the Django routes in
# payments/urls.py (mounted at /api/payments/) — i.e. /api/payments/callback/
# and /api/payments/webhook/ (NOT /api/payments/chapa/...).
# CHAPA_CALLBACK_URL=https://<your-ngrok-domain>/api/payments/callback/
# CHAPA_RETURN_URL=http://localhost:5173/payment-result/
# CHAPA_WEBHOOK_URL=https://<your-ngrok-domain>/api/payments/webhook/